<Window x:Class="AliyaPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aliya 多帧桌宠"
        Width="300" Height="470"
        MinWidth="180" MinHeight="285"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Grid>
        <Border x:Name="SpeechBubble"
                Panel.ZIndex="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8,0,8,0"
                Padding="12,8"
                CornerRadius="14"
                Background="#F7FFFFFF"
                BorderBrush="#552F2440"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="SpeechText"
                       MaxWidth="245"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Foreground="#33283A"/>
        </Border>

        <Grid x:Name="PetSurface"
              Panel.ZIndex="1"
              Margin="0,45,0,0"
              Background="Transparent"
              RenderTransformOrigin="0.5,1"
              Cursor="Hand"
              MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
              MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
              MouseMove="PetImage_MouseMove"
              MouseRightButtonUp="PetImage_MouseRightButtonUp"
              MouseWheel="PetImage_MouseWheel">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IdleTranslate" Y="0"/>
                    <ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1"/>
                    <SkewTransform x:Name="ActionSkew" AngleX="0" AngleY="0"/>
                    <RotateTransform x:Name="ActionRotate" Angle="0"/>
                    <TranslateTransform x:Name="ActionTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="PetImage"
                   Source="/Assets/aliya_pet.png"
                   Stretch="Uniform"/>
            <Grid x:Name="Live2DHost"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
