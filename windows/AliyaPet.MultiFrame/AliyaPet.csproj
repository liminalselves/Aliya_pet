<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AliyaPet.MultiFrame</AssemblyName>
    <RootNamespace>AliyaPet</RootNamespace>
    <Version>2.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\aliya_pet.png" />
    <Resource Include="Assets\aliya_pet_blink.png" />
    <Resource Include="Assets\windy_pet.png" />
    <Resource Include="Assets\windy_pet_blink.png" />
    <Content Include="Frames\**\*.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Live2D\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Live2DWeb\dist\**\*"
             Link="Live2DWeb\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="SyncLive2DAssets" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\sync-live2d-assets.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)\..\..&quot;" />
  </Target>
  <Target Name="BuildLive2DWeb" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build:prod" WorkingDirectory="$(MSBuildProjectDirectory)\Live2DWeb" />
  </Target>
  <Target Name="CopyLive2DAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <Live2DPublishFile Include="$(MSBuildProjectDirectory)\Assets\Live2D\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Live2DPublishFile)"
          DestinationFolder="$(PublishDir)Assets\Live2D\%(RecursiveDir)" />
  </Target>
</Project>
