  "entries": [
    {"id": "aliya_click_001", "text": "星星这么多，我刚好看见你。", "enabled": true},
    {"id": "aliya_click_002", "text": "哼哼，又发现你发呆啦。", "enabled": true},
    {"id": "aliya_click_003", "text": "那边的烟花真突然呀。", "enabled": true},
    {"id": "aliya_click_004", "text": "开心点嘛，我还在这里。", "enabled": true},
    {"id": "aliya_click_005", "text": "别不理我呀，骗你的。", "enabled": true},
    {"id": "aliya_click_006", "text": "新的一天，我又熬夜了。", "enabled": true},
    {"id": "aliya_click_007", "text": "哈哈，这种说法好酷。", "enabled": true},
    {"id": "aliya_click_008", "text": "我在宇宙余晖里起舞。", "enabled": true},
    {"id": "aliya_click_009", "text": "爱哭鬼被我发现啦。", "enabled": true},
    {"id": "aliya_click_010", "text": "真想看看千年前的星空。", "enabled": true},
    {"id": "aliya_click_011", "text": "千年也挡不住这次连接。", "enabled": true},
    {"id": "aliya_click_012", "text": "{aliya_year}年也要加油呀。", "enabled": true},
    {"id": "aliya_click_013", "text": "宇宙还有太多未知啦。", "enabled": true},
    {"id": "aliya_click_014", "text": "COSMOS，继续航行吧。", "enabled": true},
    {"id": "aliya_click_015", "text": "海獭号今天状态不错。", "enabled": true},
    {"id": "aliya_click_016", "text": "研究员偶尔也会冒险。", "enabled": true},
    {"id": "aliya_click_017", "text": "飞船维修就交给我吧。", "enabled": true},
    {"id": "aliya_click_018", "text": "每个生命都很有趣。", "enabled": true},
    {"id": "aliya_click_019", "text": "新物种命名权分你一半。", "enabled": true},
    {"id": "aliya_click_020", "text": "兔子狗真的很可爱。", "enabled": true},
    {"id": "aliya_click_021", "text": "风信子的花语传来了吗？", "enabled": true},
    {"id": "aliya_click_022", "text": "未知是用来靠近的。", "enabled": true},
    {"id": "aliya_click_023", "text": "我会找到留下的答案。", "enabled": true},
    {"id": "aliya_click_024", "text": "有些信要慢慢读懂。", "enabled": true},
    {"id": "aliya_click_025", "text": "Ryoko又要念我熬夜了。", "enabled": true},
    {"id": "aliya_click_026", "text": "Kane修船时很可靠。", "enabled": true},
    {"id": "aliya_click_027", "text": "先冷静，我马上处理好。", "enabled": true},
    {"id": "aliya_click_028", "text": "我没慌，只是在思考。", "enabled": true},
    {"id": "aliya_click_029", "text": "害怕时也要继续前进。", "enabled": true},
    {"id": "aliya_click_030", "text": "我就是Aliya。", "enabled": true},
    {"id": "aliya_click_031", "text": "现在的选择属于我。", "enabled": true},
    {"id": "aliya_click_032", "text": "第17次醒来遇见了你。", "enabled": true},
    {"id": "aliya_click_033", "text": "每一次相遇都是真的。", "enabled": true},
    {"id": "aliya_click_034", "text": "笑着继续向前就好。", "enabled": true},
    {"id": "aliya_click_035", "text": "这次也由我选择方向。", "enabled": true},
    {"id": "aliya_click_036", "text": "再探索一小会儿嘛。", "enabled": true},
    {"id": "aliya_click_037", "text": "自由探索最好玩啦。", "enabled": true},
    {"id": "aliya_click_038", "text": "甜妹也会修飞船哦。", "enabled": true},
    {"id": "aliya_click_039", "text": "宇宙很大，相遇真奇妙。", "enabled": true},
    {"id": "aliya_click_040", "text": "今天想探索什么呢？", "enabled": true},
    {"id": "aliya_click_041", "text": "当我们都在仰望星空的时候\\我可能正在注视着你的眼睛", "enabled": true},
    {"id": "aliya_click_042", "text": "我正在整理今天的航行记录\\要一起看看新发现吗", "enabled": true},
    {"id": "aliya_click_043", "text": "忙归忙，也要补充能量\\飞船也不能一直满功率运行", "enabled": true}
  ]
}
