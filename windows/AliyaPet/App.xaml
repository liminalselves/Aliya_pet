<Application x:Class="AliyaPet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="GlassSurfaceBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#F4FFFFFF" Offset="0"/>
            <GradientStop Color="#E8F2EEFA" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Avenir Next, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF202431"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid Margin="12">
                            <Border Padding="8"
                                    CornerRadius="20"
                                    Background="{StaticResource GlassSurfaceBrush}"
                                    BorderBrush="#D9FFFFFF"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#5F667F"
                                                      BlurRadius="24"
                                                      ShadowDepth="7"
                                                      Opacity="0.24"/>
                                </Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF202431"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemSurface"
                                    Margin="1"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="11"
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckMark"
                                               Grid.Column="0"
                                               Text="✓"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#FF6E5D96"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="›"
                                               FontSize="19"
                                               Foreground="#996E5D96"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Grid Margin="10">
                                    <Border MinWidth="190"
                                            Padding="8"
                                            CornerRadius="18"
                                            Background="{StaticResource GlassSurfaceBrush}"
                                            BorderBrush="#D9FFFFFF"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#5F667F"
                                                              BlurRadius="22"
                                                              ShadowDepth="6"
                                                              Opacity="0.22"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="#337E6CA8"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="#407E6CA8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="13,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="#55FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
