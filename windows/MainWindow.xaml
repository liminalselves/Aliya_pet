<Window x:Class="AliyaPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aliya Desktop Pet"
        AutomationProperties.Name="Aliya Desktop Pet"
        Width="440" Height="590"
        MinWidth="280" MinHeight="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        DpiChanged="Window_DpiChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="HoverActionButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#FF252A38"/>
            <Setter Property="FontFamily" Value="Avenir Next, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="BorderBrush" Value="#70FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="#70FFFFFF"/>
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="#D0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout">
        <!-- 人物显示层（缩放/旋转/倾斜/帧尺寸变化只作用于本层，工具栏独立于本层）。
             底部 Margin 预留工具栏空间（8 间距 + 64 工具栏 + 38 阴影 + 14 底部安全 = 124），
             保证工具栏完整外观（含圆角描边与阴影）位于窗口客户区内，不被底部裁切。 -->
        <Grid x:Name="CharacterContainer"
              Panel.ZIndex="10"
              Margin="70,95,70,124">
            <Image x:Name="PetImage"
                   Source="/Assets/aliya_pet.png"
                   Stretch="Uniform"
                   RenderTransformOrigin="0.5,1"
                   Cursor="Hand"
                   MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
                   MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
                   MouseMove="PetImage_MouseMove"
                   MouseEnter="PetImage_MouseEnter"
                   MouseLeave="PetImage_MouseLeave"
                   MouseRightButtonUp="PetImage_MouseRightButtonUp"
                   MouseWheel="PetImage_MouseWheel">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="IdleTranslate" Y="0"/>
                        <ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1"/>
                        <SkewTransform x:Name="ActionSkew" AngleX="0" AngleY="0"/>
                        <RotateTransform x:Name="ActionRotate" Angle="0"/>
                        <TranslateTransform x:Name="ActionTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="Live2DImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="Linear"
                   SnapsToDevicePixels="True"
                   Visibility="Collapsed"
                   Cursor="Hand"
                   IsHitTestVisible="True"
                   MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
                   MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
                   MouseMove="PetImage_MouseMove"
                   MouseEnter="PetImage_MouseEnter"
                   MouseLeave="PetImage_MouseLeave"
                   MouseRightButtonUp="PetImage_MouseRightButtonUp"
                   MouseWheel="PetImage_MouseWheel">
            </Image>
        </Grid>

        <!-- 气泡层 -->
        <Border x:Name="SpeechBubble"
                Panel.ZIndex="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8,2,8,0"
                Padding="14,10"
                CornerRadius="18"
                BorderBrush="#D9FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F5FFFFFF" Offset="0"/>
                    <GradientStop Color="#E9F2EEFA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#656681"
                                  BlurRadius="20"
                                  ShadowDepth="5"
                                  Opacity="0.24"/>
            </Border.Effect>
            <TextBlock x:Name="SpeechText"
                       MaxWidth="245"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontFamily="Avenir Next, Microsoft YaHei UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       LineHeight="21"
                       Foreground="#FF202431"/>
        </Border>

        <!-- 命中区域调试层（不参与命中测试） -->
        <Canvas x:Name="HitAreaDebugOverlay"
                Panel.ZIndex="60"
                IsHitTestVisible="False"
                Visibility="Collapsed">
        </Canvas>

        <!-- 手掌覆盖层（当前默认禁用，IsHitTestVisible=False，不参与命中） -->
        <Canvas x:Name="PettingPalmCursor"
                Panel.ZIndex="50"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Path x:Name="PettingPalmShape"
                  Width="38"
                  Height="40"
                  Fill="#EEFFFFFF"
                  Stroke="#FF253A54"
                  StrokeThickness="1.6"
                  Stretch="Uniform"
                  RenderOptions.BitmapScalingMode="HighQuality"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PettingPalmScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="PettingPalmRotate" Angle="0"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- 工具栏层：独立 Canvas，由 UpdateCharacterToolbarPlacement 定位（DIP，父级=RootLayout） -->
        <Canvas x:Name="CharacterToolbarLayer"
                Panel.ZIndex="40">
            <!-- 人物与工具栏之间的透明连接走廊：只覆盖人物底部到工具栏顶部的间隙，不覆盖按钮 -->
            <Rectangle x:Name="ToolbarHoverBridge"
                       Panel.ZIndex="35"
                       Fill="Transparent"
                       IsHitTestVisible="True"
                       Visibility="Collapsed"
                       MouseEnter="ToolbarHoverBridge_MouseEnter"
                       MouseLeave="ToolbarHoverBridge_MouseLeave"/>
            <Border x:Name="HoverQuickActions"
                    Panel.ZIndex="41"
                    MinHeight="64"
                    Padding="10,8"
                    CornerRadius="30"
                    BorderBrush="#B8FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="False"
                    SnapsToDevicePixels="False"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    MouseEnter="HoverQuickActions_MouseEnter"
                    MouseLeave="HoverQuickActions_MouseLeave">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CCFFFFFF" Offset="0"/>
                        <GradientStop Color="#B8E9E5F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#596079"
                                      BlurRadius="20"
                                      ShadowDepth="5"
                                      Opacity="0.22"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HoverQuickActionsTranslate" Y="0"/>
                </Border.RenderTransform>
                <!-- 工具栏宽度由可见按钮自动决定（左/右内边距 10 + 按钮宽度和 + 间距）。
                     抚摸模式为自动触发（鼠标悬停头部进入），工具栏不设抚摸按钮。 -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="WeatherButton"
                            Style="{StaticResource HoverActionButton}"
                            Width="100"
                            Height="46"
                            Content="天气"
                            ToolTip="查询当前天气"
                            Click="HoverWeather_Click"/>
                    <Button x:Name="ActionButton"
                            Style="{StaticResource HoverActionButton}"
                            Width="100"
                            Height="46"
                            Content="动作"
                            ToolTip="播放一个随机动作"
                            Click="HoverAction_Click"/>
                    <Button x:Name="SpeakButton"
                            Style="{StaticResource HoverActionButton}"
                            Width="100"
                            Height="46"
                            Content="说话"
                            ToolTip="让宠物说一句话"
                            Click="HoverTalk_Click"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
