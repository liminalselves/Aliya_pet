<?xml version="1.0" encoding="utf-8"?>
<!-- Content can grow with system text size; only the action list scrolls. -->
<top.liminalselves.aliyapet.MenuSheetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:clipToOutline="true"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:accessibilityHeading="true"
        android:text="@string/menu_title"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/pet_text" />

    <ScrollView
        android:id="@+id/menu_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/menu_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/menu_chip"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/menu_chat"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                android:textColor="@color/pet_accent" />

            <TextView
                android:id="@+id/menu_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/menu_records"
                android:textSize="16sp"
                android:textColor="@color/pet_text" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/pet_line" />

            <LinearLayout
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu_settings"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/menu_chip"
                    android:src="@drawable/ic_menu_settings"
                    android:tint="@color/pet_accent"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/menu_settings"
                    android:textColor="@color/pet_text"
                    android:textSize="16sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu_overlay"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/menu_chip"
                    android:src="@drawable/ic_menu_overlay"
                    android:tint="@color/pet_accent"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical"
                    android:importantForAccessibility="noHideDescendants">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_overlay"
                        android:textColor="@color/pet_text"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/menu_overlay_sub"
                        android:textColor="@color/pet_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu_about"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/menu_chip"
                    android:src="@drawable/ic_menu_info"
                    android:tint="@color/pet_accent"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/menu_about"
                    android:textColor="@color/pet_text"
                    android:textSize="16sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_quit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu_quit"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/menu_chip_red"
                    android:src="@drawable/ic_menu_quit"
                    android:tint="@color/pet_danger"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/menu_quit"
                    android:textColor="@color/pet_danger"
                    android:textSize="16sp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</top.liminalselves.aliyapet.MenuSheetLayout>
