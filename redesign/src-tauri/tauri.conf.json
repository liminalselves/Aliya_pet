{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aliya Pet",
  "version": "0.1.0",
  "identifier": "top.liminalselves.aliyapet",
  "build": {
    "beforeDevCommand": {
      "script": "node ../scripts/prepare-windows-build.mjs && npm run dev -- --host 127.0.0.1",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": {
      "script": "node ../scripts/prepare-windows-build.mjs && npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Aliya Pet",
        "width": 512,
        "height": 768,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "chat",
        "title": "Aliya 聊天",
        "url": "chat.html",
        "width": 480,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Aliya 设置",
        "url": "settings.html",
        "width": 380,
        "height": 620,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "records",
        "title": "Aliya · 聊天记录",
        "url": "records.html",
        "width": 760,
        "height": 680,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/tray.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/tray.ico",
        "uninstallerIcon": "icons/tray.ico",
        "languages": ["SimpChinese"]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
