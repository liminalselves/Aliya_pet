{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aliya Pet",
  "version": "0.1.0",
  "identifier": "top.liminalselves.aliyapet",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Aliya Pet",
        "width": 512,
        "height": 768,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/tray.ico"
    ]
  }
}