{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aliya Pet",
  "version": "0.1.0",
  "identifier": "top.liminalselves.aliyapet",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Aliya Pet",
        "width": 512,
        "height": 768,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "chat",
        "title": "Aliya 聊天",
        "url": "chat.html",
        "width": 480,
        "height": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/tray.ico"
    ]
  }
}