  "entries": [
    {"id":"aliya_petting_start_001","text":"嗯？手怎么伸过来了","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_002","text":"等一下……只能一会儿哦","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_003","text":"怎么突然放到我头上","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_004","text":"唔，我可不是小动物","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_005","text":"高马尾不许弄乱哦","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_006","text":"哼，勉强答应你了","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_007","text":"想摸可以直接说嘛","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_soft_001","text":"嗯……力度刚刚好","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_002","text":"左边一点，对，就是那","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_003","text":"你的动作还挺小心的","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_004","text":"好舒服……不许笑我","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_005","text":"头发乱了要你负责","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_006","text":"猫耳比看上去更敏感","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_007","text":"唔，再往右边一点点","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_008","text":"你的掌心好暖","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_009","text":"猫耳也顺便？那可以","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_010","text":"这样下去会习惯的","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_active_001","text":"唔……快要睡着了","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_002","text":"原来一千年前的人\\会这样表达关心啊","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_003","text":"嗯，我有在好好享受","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_004","text":"海獭号可没这项福利","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_005","text":"这算你们时代的问候吗","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_006","text":"只有一点点安心哦","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_007","text":"耳朵自己动了？\\你什么都没看见","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_008","text":"好安静，只剩呼吸声","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_009","text":"我好像把警惕收起来了","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_010","text":"一千年前也有这样的\\夜晚吗","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_011","text":"再摸可要讲真心话了","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_fast_001","text":"慢、慢一点呀","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_002","text":"你在抚摸还是在检修","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_003","text":"别把猫耳当控制杆","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_004","text":"太快了，不知往哪躲","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_005","text":"别把猫耳折过去呀","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_006","text":"速度超标了，研究员","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_007","text":"见鬼，我的发圈","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_long_001","text":"你还没有摸够吗","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_002","text":"再这样下去\\要放松警惕了","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_003","text":"时间好像被你按慢了","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_004","text":"如果COSMOS记下了\\记得替我删掉","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_005","text":"嗯……再待一会儿也行","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_006","text":"深夜有人陪着，很好","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_007","text":"我不困，真的……才怪","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_008","text":"掌心温度我记得住","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_repeat_001","text":"今天已经摸过很多次了","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_002","text":"你是不是发现\\我不会拒绝你了","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_003","text":"又来？好吧，算你通过","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_004","text":"你对猫耳太好奇了哦","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_005","text":"今天的份额早就用完啦","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_006","text":"你这是上瘾了吧","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_007","text":"再摸可要收费了哦","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_end_001","text":"结束了吗？\\我才没有舍不得","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_002","text":"头发没乱吧？\\帮我确认一下","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_003","text":"好了，恢复警戒……大概","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_004","text":"谢谢。刚才我很放松","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_005","text":"下次也行，但要轻一点","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_006","text":"手拿开了，风有点凉","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_007","text":"我记住这个温度了","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_008","text":"下次记得先问我一句","weight":1.0,"tags":["petting_end"],"enabled":true}
  ]
