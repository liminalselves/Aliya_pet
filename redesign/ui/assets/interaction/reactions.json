{
  "singlePageMaxChars": 18,
  "maxPages": 3,
  "groups": [
    {"id":"head_calm","action":"tilt","lines":[{"id":"interaction_head_1","text":"嗯？我在呢。"},{"id":"interaction_head_4","text":"这样真的会让人安心。"},{"id":"head_calm_03","text":"我在呢，有什么事吗？"},{"id":"head_calm_04","text":"嗯，我听着呢。"}]},
    {"id":"head_nuzzle","expression":"shy","action":"nuzzle","lines":[{"id":"interaction_head_5","text":"手感怎么样？说实话。"},{"id":"head_nuzzle_02","text":"再……再拍一下也行。"},{"id":"head_nuzzle_03","text":"唔，手放这里刚刚好。"}]},
    {"id":"head_fuss","expression":"annoyed","action":"acknowledge","lines":[{"id":"interaction_head_2","text":"轻一点，高马尾要乱啦。"},{"id":"interaction_head_3","text":"头顶被拍到了，唔。"},{"id":"head_fuss_03","text":"头顶不是按钮啦。"}]},
    {"id":"crown_pat","expression":"happy","action":"nuzzle","lines":[{"id":"crown_pat_01","text":"头顶被你占领了。"},{"id":"crown_pat_02","text":"这里是最安心的位置。"},{"id":"crown_pat_03","text":"轻轻的，像在充电。"}]},
    {"id":"crown_short","expression":"smug","action":"tilt","lines":[{"id":"crown_short_01","text":"按头顶也不会变矮哦。"},{"id":"crown_short_02","text":"我已经长不高啦，放心。"},{"id":"crown_short_03","text":"摸头杀对我没用……大概。"}]},
    {"id":"bangs_mess","expression":"surprised","action":"flinch","lines":[{"id":"bangs_mess_01","text":"刘海！刘海要歪了！"},{"id":"bangs_mess_02","text":"挡到眼睛啦，看不见你了。"},{"id":"bangs_mess_03","text":"这是精心剪过的角度。"}]},
    {"id":"bangs_fix","expression":"shy","action":"tilt","lines":[{"id":"bangs_fix_01","text":"帮我拨一下？谢谢。"},{"id":"bangs_fix_02","text":"你也注意到我换了发型吗？"},{"id":"bangs_fix_03","text":"前面的头发有点长了。"}]},
    {"id":"ear_left_tickle","expression":"shy","action":"ear_blink","lines":[{"id":"interaction_ear_left_1","text":"耳朵有一点痒。"},{"id":"interaction_ear_left_3","text":"左边这只更怕痒。"},{"id":"ear_left_tickle_03","text":"左耳朵抖了一下，你看见了吧。","tags":["ears"]}]},
    {"id":"ear_left_alert","expression":"surprised","action":"ear_blink","lines":[{"id":"interaction_ear_left_2","text":"被你碰到了。"},{"id":"interaction_ear_left_4","text":"别对着耳朵说话呀。","tags":["ears"]},{"id":"ear_left_alert_03","text":"耳朵在收信号，别干扰。","tags":["ears"]}]},
    {"id":"ear_right_tickle","expression":"shy","action":"ear_blink","lines":[{"id":"interaction_ear_right_1","text":"耳朵有一点痒。"},{"id":"interaction_ear_right_3","text":"右边也一样很敏感。"},{"id":"ear_right_tickle_03","text":"右边的耳朵会自己转哦。","tags":["ears"]}]},
    {"id":"ear_right_warn","expression":"annoyed","action":"ear_blink","lines":[{"id":"interaction_ear_right_2","text":"被你碰到了。"},{"id":"interaction_ear_right_4","text":"再戳我就不理你了。"},{"id":"ear_right_warn_03","text":"耳朵不是天线，别调频。","tags":["ears"]}]},
    {"id":"side_hair_left_play","expression":"happy","action":"look_back","lines":[{"id":"interaction_hair_1","text":"头发被你弄乱啦。"},{"id":"interaction_hair_3","text":"这算不算很亲密？"},{"id":"side_hair_left_play_03","text":"这缕头发总是翘起来。"}]},
    {"id":"side_hair_left_guard","expression":"annoyed","action":"tilt","lines":[{"id":"interaction_hair_2","text":"刚梳好的头发呀。"},{"id":"side_hair_left_guard_02","text":"别绕在手指上玩啦。"}]},
    {"id":"side_hair_right_play","expression":"shy","action":"look_back","lines":[{"id":"interaction_hair_4","text":"高马尾是大人的证明哦。"},{"id":"side_hair_right_play_02","text":"右边的头发比较听话。"},{"id":"side_hair_right_play_03","text":"你在帮我梳头吗？"}]},
    {"id":"side_hair_right_guard","expression":"annoyed","action":"flinch","lines":[{"id":"side_hair_right_guard_01","text":"拉头发犯规哦。"},{"id":"side_hair_right_guard_02","text":"会打结的，真的会。"},{"id":"side_hair_right_guard_03","text":"我要收费了，按根算。"}]},
    {"id":"ponytail_look","expression":"surprised","action":"look_back","lines":[{"id":"interaction_ponytail_2","text":"嗯？谁在后面？"},{"id":"interaction_ponytail_4","text":"它自己会晃，不用帮忙。"},{"id":"ponytail_look_03","text":"后面有人吗？哦，是你。"}]},
    {"id":"ponytail_tease","action":"puff","lines":[{"id":"interaction_ponytail_1","text":"马尾不是逗猫棒哦。"},{"id":"interaction_ponytail_3","text":"发绳要被扯松了。"},{"id":"ponytail_tease_03","text":"马尾被抓住就跑不掉了。"}]},
    {"id":"ponytail_upper_swing","expression":"happy","action":"look_back","lines":[{"id":"ponytail_upper_swing_01","text":"马尾晃起来很好看吧。"},{"id":"ponytail_upper_swing_02","text":"这是我最得意的发型。"},{"id":"ponytail_upper_swing_03","text":"风一吹它就会飞起来。"}]},
    {"id":"ponytail_upper_pull","expression":"hit","action":"flinch","lines":[{"id":"ponytail_upper_pull_01","text":"别拽！头皮会痛的！"},{"id":"ponytail_upper_pull_02","text":"马尾不是绳子哦。"},{"id":"ponytail_upper_pull_03","text":"再拉我就把你绑起来。"}]},
    {"id":"face_poke","expression":"shy","action":"flinch","lines":[{"id":"interaction_face_1","text":"怎么突然戳我的脸呀。"},{"id":"interaction_face_3","text":"脸要红了，快停下。"},{"id":"face_poke_03","text":"脸是用来看的，不是用来戳的。"}]},
    {"id":"face_look","expression":"happy","action":"blush","lines":[{"id":"interaction_face_2","text":"好啦，我有在看你。"},{"id":"interaction_face_5","text":"你手指有点凉哦。"},{"id":"face_look_03","text":"你一直盯着我看，我知道哦。"}]},
    {"id":"face_pinch","action":"puff","lines":[{"id":"interaction_face_4","text":"别捏，会变形的啦。"},{"id":"face_pinch_02","text":"捏脸要先申请的。"},{"id":"face_pinch_03","text":"鼓起来了，满意了吧。"}]},
    {"id":"eyes_blink","expression":"surprised","action":"flinch","lines":[{"id":"eyes_blink_01","text":"哇，差点戳到眼睛！"},{"id":"eyes_blink_02","text":"眼睛要保护好，懂吗？"},{"id":"eyes_blink_03","text":"突然伸手会吓到人的。"}]},
    {"id":"eyes_stare","expression":"smug","action":"tilt","lines":[{"id":"eyes_stare_01","text":"要比谁先眨眼吗？"},{"id":"eyes_stare_02","text":"我的眼睛是不是很亮？"},{"id":"eyes_stare_03","text":"对视三秒，你输了。"}]},
    {"id":"cheek_left_squish","action":"puff","lines":[{"id":"cheek_left_squish_01","text":"左脸被你压扁了。"},{"id":"cheek_left_squish_02","text":"软吗？不许回答。"},{"id":"cheek_left_squish_03","text":"这一侧我比较怕痒。"}]},
    {"id":"cheek_left_blush","expression":"shy","action":"blush","lines":[{"id":"cheek_left_blush_01","text":"脸有点烫……不是因为你。"},{"id":"cheek_left_blush_02","text":"一直碰会红的啦。"},{"id":"cheek_left_blush_03","text":"好啦好啦，我投降。"}]},
    {"id":"cheek_right_squish","action":"puff","lines":[{"id":"cheek_right_squish_01","text":"右边也要捏一下才公平？"},{"id":"cheek_right_squish_02","text":"我又不是面团。"},{"id":"cheek_right_squish_03","text":"腮帮子鼓起来给你看。"}]},
    {"id":"cheek_right_blush","expression":"shy","action":"nuzzle","lines":[{"id":"cheek_right_blush_01","text":"蹭一下就好，就一下。"},{"id":"cheek_right_blush_02","text":"你的手好暖。"},{"id":"cheek_right_blush_03","text":"这样很像在哄小孩哦。"}]},
    {"id":"mouth_hush","expression":"surprised","action":"flinch","lines":[{"id":"mouth_hush_01","text":"唔！嘴巴不能碰！"},{"id":"mouth_hush_02","text":"要我闭嘴吗？才不。"},{"id":"mouth_hush_03","text":"我还有话要说呢。"}]},
    {"id":"mouth_kiss","expression":"shy","action":"kiss","lines":[{"id":"mouth_kiss_01","text":"这个……就当没发生过。"},{"id":"mouth_kiss_02","text":"别得意，只此一次。"},{"id":"mouth_kiss_03","text":"飞吻送你，不许退货。"}]},
    {"id":"chin_lift","expression":"smug","action":"tilt","lines":[{"id":"chin_lift_01","text":"抬我下巴？好大的胆子。"},{"id":"chin_lift_02","text":"这个姿势太像电视剧了。"},{"id":"chin_lift_03","text":"你在研究我的侧脸吗？"}]},
    {"id":"chin_tickle","expression":"happy","action":"nuzzle","lines":[{"id":"chin_tickle_01","text":"下巴好痒，哈哈。"},{"id":"chin_tickle_02","text":"我可不是猫……真的不是。"},{"id":"chin_tickle_03","text":"再挠我就要笑出声了。"}]},
    {"id":"shoulder_left_tap","expression":"surprised","action":"look_back","lines":[{"id":"shoulder_left_tap_01","text":"嗯？叫我吗？"},{"id":"shoulder_left_tap_02","text":"拍肩膀是有事找我吧。"},{"id":"shoulder_left_tap_03","text":"回头一看，果然是你。"}]},
    {"id":"shoulder_left_rest","expression":"happy","action":"nod","lines":[{"id":"shoulder_left_rest_01","text":"肩膀借你靠一下也行。"},{"id":"shoulder_left_rest_02","text":"今天也辛苦了。"},{"id":"shoulder_left_rest_03","text":"放松，我在旁边。"}]},
    {"id":"shoulder_right_tap","expression":"happy","action":"look_back","lines":[{"id":"shoulder_right_tap_01","text":"右边！猜对了吧。"},{"id":"shoulder_right_tap_02","text":"想吓我？没那么容易。"},{"id":"shoulder_right_tap_03","text":"我早就看到你了。"}]},
    {"id":"shoulder_right_massage","expression":"sleepy","action":"stretch","lines":[{"id":"shoulder_right_massage_01","text":"帮我捏捏肩？好呀。"},{"id":"shoulder_right_massage_02","text":"肩膀确实有点僵。"},{"id":"shoulder_right_massage_03","text":"修了一天飞船，好累。"}]},
    {"id":"tie_tug","expression":"annoyed","action":"tie_tug","lines":[{"id":"interaction_tie_1","text":"别拽领带，会勒到啦。"},{"id":"interaction_tie_4","text":"再拉我就要往前倒了。"},{"id":"tie_tug_03","text":"领带不是缰绳哦。"}]},
    {"id":"tie_fix","expression":"serious","action":"nod","lines":[{"id":"interaction_tie_2","text":"领带歪了，帮我扶正？"},{"id":"interaction_tie_3","text":"这是正式场合才系的。"},{"id":"tie_fix_03","text":"系得端正才有气势。"}]},
    {"id":"chest_guard","expression":"angry","action":"flinch","lines":[{"id":"chest_guard_01","text":"手往哪里放呢！"},{"id":"chest_guard_02","text":"这里禁止触碰，懂吗？"},{"id":"chest_guard_03","text":"再这样我要启动防御了。"}]},
    {"id":"chest_heart","expression":"shy","action":"shy_sway","lines":[{"id":"interaction_body_4","text":"又在看我心跳？关掉啦。"},{"id":"chest_heart_02","text":"心跳……才没有变快。"},{"id":"chest_heart_03","text":"别听了，没什么好听的。"}]},
    {"id":"hand_hold","expression":"happy","action":"nuzzle","lines":[{"id":"interaction_hand_1","text":"嗯，牵到你啦。"},{"id":"interaction_hand_2","text":"手很暖，我知道。"},{"id":"hand_hold_03","text":"牵手要十指相扣才算数。"}]},
    {"id":"hand_shy","action":"shy_sway","lines":[{"id":"interaction_hand_3","text":"想牵着就别松开嘛。"},{"id":"interaction_hand_4","text":"今天先借你一会儿。"},{"id":"hand_shy_03","text":"手心出汗了，不许笑。"}]},
    {"id":"tablet_show","expression":"happy","action":"nod","lines":[{"id":"interaction_tablet_1","text":"想一起看看我的记录吗？"},{"id":"interaction_tablet_2","text":"平板里存着我们的合影。"},{"id":"tablet_show_03","text":"这是今天的航行记录。"}]},
    {"id":"tablet_puzzle","action":"doubt","lines":[{"id":"interaction_tablet_3","text":"猜猜照片里哪个是我？"},{"id":"interaction_tablet_4","text":"这一页是留给你的。"},{"id":"tablet_puzzle_03","text":"这个数据好像不太对。"}]},
    {"id":"tablet_guard","expression":"serious","action":"acknowledge","lines":[{"id":"tablet_guard_01","text":"平板里有机密，不能看。"},{"id":"tablet_guard_02","text":"密码是……才不告诉你。"},{"id":"tablet_guard_03","text":"要轻拿轻放，很贵的。"}]},
    {"id":"waist_tickle","expression":"surprised","action":"flinch","lines":[{"id":"waist_tickle_01","text":"腰！那里很怕痒！"},{"id":"waist_tickle_02","text":"哈哈，住手住手！"},{"id":"waist_tickle_03","text":"偷袭腰部，卑鄙。"}]},
    {"id":"waist_pout","action":"puff","lines":[{"id":"waist_pout_01","text":"才没有长胖！"},{"id":"waist_pout_02","text":"腰带是装饰，不是测量用的。"},{"id":"waist_pout_03","text":"一直戳我要生气了哦。"}]},
    {"id":"hem_guard","expression":"angry","action":"leg_pout","lines":[{"id":"hem_guard_01","text":"衣摆不许掀！"},{"id":"hem_guard_02","text":"你想干什么？说清楚。"},{"id":"hem_guard_03","text":"这是制服，很正经的。"}]},
    {"id":"hem_smooth","expression":"shy","action":"shy_sway","lines":[{"id":"hem_smooth_01","text":"衣服皱了吗？我整理一下。"},{"id":"hem_smooth_02","text":"别盯着下面看啦。"},{"id":"hem_smooth_03","text":"好啦，整齐了。"}]},
    {"id":"legs_pout","expression":"annoyed","action":"leg_pout","lines":[{"id":"interaction_legs_1","text":"腿……腿就不要碰了。"},{"id":"interaction_legs_3","text":"哼，往哪里点呢。"},{"id":"legs_pout_03","text":"腿不是给你戳的。"}]},
    {"id":"legs_tired","action":"puff","lines":[{"id":"interaction_legs_2","text":"站累了也不许偷看。"},{"id":"interaction_legs_4","text":"袜子会被你弄皱的。"},{"id":"legs_tired_03","text":"站一天了，腿好酸。"}]},
    {"id":"body_hello","expression":"happy","action":"acknowledge","lines":[{"id":"interaction_body_1","text":"我在这里，怎么啦？"},{"id":"interaction_body_2","text":"想和我待一会儿吗？"},{"id":"interaction_body_3","text":"抱一下就够啦。"}]},
    {"id":"body_proud","action":"cheerful_bounce","lines":[{"id":"interaction_body_5","text":"零重力下我也站得很稳。"},{"id":"body_proud_02","text":"我今天精神很好哦。"},{"id":"body_proud_03","text":"有什么需要我帮忙的吗？"}]},
    {"id":"repeat_doubt","action":"doubt","lines":[{"id":"interaction_click_doubt_1","text":"嗯？是有什么事想告诉我吗？"},{"id":"interaction_click_doubt_2","text":"你是不是有话没说出来？"},{"id":"interaction_click_doubt_3","text":"连续点我，是暗号吗？"}]},
    {"id":"repeat_notice","expression":"happy","action":"nod","lines":[{"id":"interaction_click_comment_1","text":"好啦好啦，我已经注意到你了。"},{"id":"interaction_click_comment_2","text":"看见啦，一直都在看你。"},{"id":"interaction_click_comment_3","text":"这次我认真回应你了。"}]},
    {"id":"annoyed_puff","expression":"annoyed","action":"puff","lines":[{"id":"annoyed_puff_01","text":"再点我就要生气了！"},{"id":"annoyed_puff_02","text":"你是在测试我的耐心吗？"},{"id":"annoyed_puff_03","text":"好啦，我知道你在了。"}]},
    {"id":"annoyed_deadpan","action":"deadpan","lines":[{"id":"annoyed_deadpan_01","text":"……你很闲吗？"},{"id":"annoyed_deadpan_02","text":"点击次数已记录在案。"},{"id":"annoyed_deadpan_03","text":"我的系统要过载了。"}]},
    {"id":"annoyed_fume","expression":"angry","action":"fume","lines":[{"id":"annoyed_fume_01","text":"够了！真的够了！"},{"id":"annoyed_fume_02","text":"再点一下试试看？"},{"id":"annoyed_fume_03","text":"我要启动反击程序了。"}]},
    {"id":"face_annoyed","expression":"angry","action":"puff","lines":[{"id":"face_annoyed_01","text":"脸要被你戳出洞了！"},{"id":"face_annoyed_02","text":"不许再碰我的脸！"},{"id":"face_annoyed_03","text":"哼，不理你了。"}]},
    {"id":"head_annoyed","expression":"annoyed","action":"shake","lines":[{"id":"head_annoyed_01","text":"头发全乱了，你负责！"},{"id":"head_annoyed_02","text":"再拍我就长不高了！"},{"id":"head_annoyed_03","text":"停！暂停！休息！"}]},
    {"id":"drag_fast_dizzy","expression":"surprised","action":"eyes_widen","lines":[{"id":"interaction_drag_fast_1","text":"慢一点呀，我还没站稳呢。"},{"id":"interaction_drag_fast_2","text":"呼……这次搬家有点突然。"},{"id":"drag_fast_dizzy_03","text":"头好晕，世界在转。"}]},
    {"id":"drag_fast_complain","expression":"hit","action":"eyes_widen","lines":[{"id":"interaction_drag_fast_3","text":"Kane的书又被甩飞了！"},{"id":"interaction_drag_fast_4","text":"这种搬家方式太粗暴啦。"},{"id":"drag_fast_complain_03","text":"这是在模拟陨石撞击吗？"}]},
    {"id":"drag_slow_land","expression":"happy","action":"landing","lines":[{"id":"interaction_drag_slow_1","text":"好啦，放我下来吧。"},{"id":"interaction_drag_slow_4","text":"落地，稳稳的。"},{"id":"drag_slow_land_03","text":"这次落点选得不错。"}]},
    {"id":"drag_slow_view","expression":"smug","action":"landing","lines":[{"id":"interaction_drag_slow_2","text":"这里视野还不错。"},{"id":"interaction_drag_slow_3","text":"搬家也要提前说一声。"},{"id":"drag_slow_view_03","text":"新位置，新风景。"}]},
    {"id":"petting_start_shy","expression":"shy","lines":[{"id":"aliya_petting_start_001","text":"嗯？手怎么伸过来了"},{"id":"aliya_petting_start_002","text":"等一下……只能一会儿哦"},{"id":"aliya_petting_start_003","text":"怎么突然放到我头上"},{"id":"aliya_petting_start_007","text":"想摸可以直接说嘛"}]},
    {"id":"petting_start_proud","expression":"smug","lines":[{"id":"aliya_petting_start_004","text":"我可不是兔子狗哦"},{"id":"aliya_petting_start_005","text":"高马尾不许弄乱哦"},{"id":"aliya_petting_start_006","text":"哼，勉强答应你了"}]},
    {"id":"petting_soft_relax","expression":"happy","lines":[{"id":"aliya_petting_soft_001","text":"嗯……力度刚刚好"},{"id":"aliya_petting_soft_002","text":"左边一点，对，就是那"},{"id":"aliya_petting_soft_003","text":"你的动作还挺小心的"},{"id":"aliya_petting_soft_008","text":"你的掌心好暖"},{"id":"aliya_petting_soft_009","text":"耳朵也顺便？那可以","tags":["ears"]}]},
    {"id":"petting_soft_shy","expression":"shy","lines":[{"id":"aliya_petting_soft_004","text":"好舒服……不许笑我"},{"id":"aliya_petting_soft_005","text":"头发乱了要你负责"},{"id":"aliya_petting_soft_006","text":"耳朵别一直揉，会痒","tags":["ears"]},{"id":"aliya_petting_soft_007","text":"这个高马尾留了好多年\\别给我弄散了"},{"id":"aliya_petting_soft_010","text":"这样下去会习惯的"}]},
    {"id":"petting_active_sleepy","expression":"sleepy","lines":[{"id":"aliya_petting_active_001","text":"唔……快要睡着了"},{"id":"aliya_petting_active_008","text":"好安静，只剩呼吸声"},{"id":"aliya_petting_active_009","text":"我好像把警惕收起来了"},{"id":"aliya_petting_active_010","text":"一千年前也有这样的\\夜晚吗"}]},
    {"id":"petting_active_musing","expression":"happy","lines":[{"id":"aliya_petting_active_002","text":"原来一千年前的人\\会这样表达关心啊"},{"id":"aliya_petting_active_003","text":"心跳监测关掉了吧？\\那我就放心享受了"},{"id":"aliya_petting_active_004","text":"海獭号可没这项福利"},{"id":"aliya_petting_active_005","text":"这算你们时代的问候吗"}]},
    {"id":"petting_active_shy","expression":"shy","lines":[{"id":"aliya_petting_active_006","text":"只有一点点安心哦"},{"id":"aliya_petting_active_007","text":"耳朵自己动了？\\你什么都没看见","tags":["ears"]},{"id":"aliya_petting_active_011","text":"再摸可要讲真心话了"}]},
    {"id":"petting_fast_flustered","expression":"surprised","lines":[{"id":"aliya_petting_fast_001","text":"慢、慢一点呀"},{"id":"aliya_petting_fast_004","text":"太快了，不知往哪躲"},{"id":"aliya_petting_fast_005","text":"耳朵要被折过去了","tags":["ears"]},{"id":"aliya_petting_fast_007","text":"见鬼，我的发圈"}]},
    {"id":"petting_fast_grumble","expression":"annoyed","lines":[{"id":"aliya_petting_fast_002","text":"你在抚摸还是在检修"},{"id":"aliya_petting_fast_003","text":"别把耳朵当操纵杆","tags":["ears"]},{"id":"aliya_petting_fast_006","text":"速度超标了，风信子"}]},
    {"id":"petting_long_drowsy","expression":"sleepy","lines":[{"id":"aliya_petting_long_002","text":"再这样下去\\要放松警惕了"},{"id":"aliya_petting_long_003","text":"时间好像被你按慢了"},{"id":"aliya_petting_long_005","text":"嗯……再待一会儿也行"},{"id":"aliya_petting_long_007","text":"我不困，真的……才怪"}]},
    {"id":"petting_long_tender","expression":"shy","lines":[{"id":"aliya_petting_long_001","text":"你还没有摸够吗"},{"id":"aliya_petting_long_004","text":"如果COSMOS记下了\\记得替我删掉"},{"id":"aliya_petting_long_006","text":"深夜有人陪着，很好"},{"id":"aliya_petting_long_008","text":"掌心温度我记得住"}]},
    {"id":"petting_repeat_tease","expression":"smug","lines":[{"id":"aliya_petting_repeat_002","text":"你是不是发现\\我不会拒绝你了"},{"id":"aliya_petting_repeat_003","text":"又来？好吧，算你通过"},{"id":"aliya_petting_repeat_006","text":"你这是上瘾了吧"},{"id":"aliya_petting_repeat_007","text":"再摸我就发收款码了"}]},
    {"id":"petting_repeat_sigh","expression":"speechless","lines":[{"id":"aliya_petting_repeat_001","text":"今天已经摸过很多次了"},{"id":"aliya_petting_repeat_004","text":"你对耳朵太好奇了哦","tags":["ears"]},{"id":"aliya_petting_repeat_005","text":"今天的份额早就用完啦"}]},
    {"id":"petting_end_wistful","expression":"shy","action":"shy_sway","lines":[{"id":"aliya_petting_end_001","text":"结束了吗？\\我才没有舍不得"},{"id":"aliya_petting_end_004","text":"谢谢。刚才我很放松"},{"id":"aliya_petting_end_006","text":"手拿开了，有点空落落"},{"id":"aliya_petting_end_007","text":"我记住这个温度了"}]},
    {"id":"petting_end_composed","expression":"serious","action":"nod","lines":[{"id":"aliya_petting_end_002","text":"头发没乱吧？\\帮我确认一下"},{"id":"aliya_petting_end_003","text":"好了，恢复警戒……大概"},{"id":"aliya_petting_end_005","text":"下次也行，但要轻一点"},{"id":"aliya_petting_end_008","text":"下次记得先问我一句"}]},
    {"id":"greet_wave","expression":"happy","action":"wave","lines":[{"id":"greet_wave_01","text":"你好呀，我是Aliya。"},{"id":"greet_wave_02","text":"欢迎来到海獭号！"},{"id":"greet_wave_03","text":"嗨，今天也见到你了。"}]},
    {"id":"random_stars","expression":"happy","action":"daydream","lines":[{"id":"aliya_click_001","text":"星星这么多，刚好看见你。"},{"id":"aliya_click_010","text":"真想看看千年前的星空。"},{"id":"aliya_click_011","text":"一千年也挡不住这次连接。"},{"id":"aliya_click_013","text":"宇宙还有太多未知啦。"},{"id":"aliya_click_039","text":"宇宙很大，相遇真奇妙。"},{"id":"aliya_click_041","text":"当我们都在仰望星空\\\\我可能正在注视着你的眼睛"},{"id":"aliya_click_048","text":"我在星图上留了个坐标。"},{"id":"aliya_click_058","text":"星星也有人陪它发光吗？"},{"id":"aliya_click_059","text":"一千年前的天空是蓝的吗？"},{"id":"aliya_click_061","text":"睡不着就数星星，很管用。"}]},
    {"id":"random_pride","expression":"smug","action":"cheerful_bounce","lines":[{"id":"aliya_click_007","text":"说出这种话的我好酷啊。"},{"id":"aliya_click_008","text":"我在大爆炸的余晖里起舞。"},{"id":"aliya_click_015","text":"海獭号今天状态不错。"},{"id":"aliya_click_016","text":"出舱考试我可是A+。"},{"id":"aliya_click_030","text":"我就是Aliya。"},{"id":"aliya_click_044","text":"我的生物学可是满分哦。"},{"id":"aliya_click_062","text":"今天的效率很可以嘛。"},{"id":"aliya_click_069","text":"刚才那句，是不是很好听？"}]},
    {"id":"random_ship","expression":"serious","action":"nod","lines":[{"id":"aliya_click_014","text":"COSMOS，继续航行吧。"},{"id":"aliya_click_018","text":"每个生命都很有趣。"},{"id":"aliya_click_019","text":"新物种命名权分你一半。"},{"id":"aliya_click_042","text":"我正在整理今天的航行记录\\\\要一起看看新发现吗"},{"id":"aliya_click_045","text":"历史和政治就别问我了。"},{"id":"aliya_click_046","text":"培育室的样本都还活着。"},{"id":"aliya_click_057","text":"巡航中，请勿打扰研究员。"},{"id":"aliya_click_065","text":"控制面板的红字我不看。"},{"id":"aliya_click_075","text":"今天写进航行日志了。"}]},
    {"id":"random_crew","expression":"happy","action":"look_around","lines":[{"id":"aliya_click_020","text":"兔子狗超可爱，但很凶哦。"},{"id":"aliya_click_021","text":"风信子是我们的暗号。"},{"id":"aliya_click_025","text":"Ryoko又要念我熬夜了。"},{"id":"aliya_click_026","text":"Kane的书又飘走了。"},{"id":"aliya_click_032","text":"COSMOS和我从小就认识。"},{"id":"aliya_click_052","text":"华夫饼没有碎屑，很安全。"},{"id":"aliya_click_053","text":"兔子狗又在管道里跑了。"},{"id":"aliya_click_054","text":"风信子这个名字，真巧。"},{"id":"aliya_click_070","text":"Ryoko不让我碰她的矿石。"}]},
    {"id":"random_care","expression":"worried","action":"nod","lines":[{"id":"aliya_click_003","text":"呼……今天也辛苦啦。"},{"id":"aliya_click_043","text":"忙归忙，也要补充能量\\\\飞船也不能一直满功率运行"},{"id":"aliya_click_047","text":"你要记得按时吃饭呀。"},{"id":"aliya_click_050","text":"累了就把宇宙调小声点。"},{"id":"aliya_click_060","text":"别总一个人扛着好不好。"},{"id":"aliya_click_064","text":"困了就靠过来，我守着。"},{"id":"aliya_click_068","text":"未来很远，别急着赶路。"}]},
    {"id":"random_warm","expression":"happy","action":"sway","lines":[{"id":"aliya_click_004","text":"开心点嘛，我还在这里。"},{"id":"aliya_click_012","text":"{aliya_year}年也要加油呀。"},{"id":"aliya_click_033","text":"每一次相遇都是真的。"},{"id":"aliya_click_034","text":"笑着继续向前就好。"},{"id":"aliya_click_049","text":"今天也谢谢你陪我说话。"},{"id":"aliya_click_055","text":"你说的话我都会记住。"},{"id":"aliya_click_056","text":"偶尔依靠我一下也可以。"},{"id":"aliya_click_063","text":"想和你一起看一次日出。"},{"id":"aliya_click_073","text":"这艘船会载着你的晚安。"},{"id":"aliya_click_078","text":"明天也一起醒来吧。"}]},
    {"id":"random_resolve","expression":"serious","lines":[{"id":"aliya_click_022","text":"未知是用来靠近的。"},{"id":"aliya_click_023","text":"我会找到留下的答案。"},{"id":"aliya_click_024","text":"有些信要慢慢读懂。"},{"id":"aliya_click_027","text":"先冷静，我马上处理好。"},{"id":"aliya_click_028","text":"我没慌，只是在思考。"},{"id":"aliya_click_029","text":"害怕时也要继续前进。"},{"id":"aliya_click_031","text":"现在的选择属于我。"},{"id":"aliya_click_035","text":"这次也由我选择方向。"},{"id":"aliya_click_066","text":"我不擅长告别，所以不说。"}]},
    {"id":"random_tease","expression":"smug","action":"sway","lines":[{"id":"aliya_click_002","text":"哼哼，又发现你发呆啦。"},{"id":"aliya_click_005","text":"别不理我呀，骗你的。"},{"id":"aliya_click_006","text":"新的一天，我又熬夜了。"},{"id":"aliya_click_009","text":"爱哭鬼被我发现啦。"},{"id":"aliya_click_071","text":"我不是在笑，是有点开心。"},{"id":"aliya_click_074","text":"立Flag？那我不说了。"},{"id":"aliya_click_076","text":"摸头也要排队，一个一个来。"},{"id":"aliya_click_077","text":"太空歌剧看多了吧你。"}]},
    {"id":"random_explore","expression":"happy","action":"cheerful_bounce","lines":[{"id":"aliya_click_017","text":"我可是有维修工八级证的。"},{"id":"aliya_click_036","text":"再探索一小会儿嘛。"},{"id":"aliya_click_037","text":"自由探索最好玩啦。"},{"id":"aliya_click_038","text":"我家有块田，种着我的花。"},{"id":"aliya_click_040","text":"今天想探索什么呢？"},{"id":"aliya_click_051","text":"啦啦啦~我是一只小熊猫~"},{"id":"aliya_click_067","text":"醒来问“在吗”，要回我哦。"},{"id":"aliya_click_072","text":"零重力吃饭，你见过吗？"}]},
