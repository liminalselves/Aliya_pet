{
  "characterId": "aliya",
  "category": "interaction",
  "scene": "head_petting",
  "selectionMode": "shuffle_bag",
  "singlePageMaxChars": 18,
  "maxPages": 3,
  "entries": [
    {"id":"aliya_petting_start_001","text":"嗯？你是想摸摸我的头吗？","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_002","text":"等一下……好吧，只能一会儿哦。","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_003","text":"怎么突然把手放到我头上了？","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_start_004","text":"唔，我可不是小动物哦。","weight":1.0,"tags":["petting_start"],"enabled":true},
    {"id":"aliya_petting_soft_001","text":"嗯……这个力度刚刚好。","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_002","text":"再往左边一点，对，就是那里。","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_003","text":"你的动作还挺小心的嘛。","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_004","text":"好舒服……不许笑我。","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_005","text":"头发会乱的，不过……算了。","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_soft_006","text":"猫耳可比看上去敏感多了。","weight":1.0,"tags":["petting_soft"],"enabled":true},
    {"id":"aliya_petting_active_001","text":"唔……感觉快要睡着了。","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_002","text":"原来一千年前的人，会这样表达关心啊。","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_003","text":"嗯，我有在好好享受，别停得太突然。","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_004","text":"海獭号的船员福利里，可没有这一项。","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_005","text":"这算是你们时代的特殊问候吗？","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_006","text":"稍微有点安心……只有一点点。","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_active_007","text":"耳朵自己动了？你什么都没看见。","weight":1.0,"tags":["petting_active"],"enabled":true},
    {"id":"aliya_petting_fast_001","text":"慢、慢一点，头发真的要乱啦。","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_002","text":"你是在抚摸，还是在检查我的脑袋？","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_003","text":"等等，别把猫耳当成控制杆呀。","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_fast_004","text":"太快了，我都不知道该往哪边躲了。","weight":1.0,"tags":["petting_fast"],"enabled":true},
    {"id":"aliya_petting_long_001","text":"你还没有摸够吗……我倒是不讨厌。","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_002","text":"再这样下去，我真的会放松警惕的。","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_003","text":"时间好像慢下来了……这种感觉还不错。","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_004","text":"如果COSMOS记录了这一段，记得替我删掉。","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_long_005","text":"嗯……再待一会儿也没关系。","weight":1.0,"tags":["petting_long"],"enabled":true},
    {"id":"aliya_petting_repeat_001","text":"今天已经摸过很多次了吧？","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_002","text":"你是不是发现我不会真的拒绝你了？","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_003","text":"又来？好吧，这次也算你通过。","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_repeat_004","text":"你对猫耳是不是有点太好奇了？","weight":1.0,"tags":["petting_repeat"],"enabled":true},
    {"id":"aliya_petting_end_001","text":"结束了吗？嗯……我才没有舍不得。","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_002","text":"头发没乱吧？你要负责帮我确认。","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_003","text":"好了，我恢复警戒状态了……大概。","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_004","text":"谢谢。刚才那一会儿，我很放松。","weight":1.0,"tags":["petting_end"],"enabled":true},
    {"id":"aliya_petting_end_005","text":"下次也不是不可以，不过要轻一点。","weight":1.0,"tags":["petting_end"],"enabled":true}
  ]
}
